# Used by `npm run build` (Cloudflare builds the live app with it).
# Not a secret: this address ends up inside the public app anyway.
# A VITE_API_URL set on Cloudflare, or in the shell, takes priority over this file.
# To build locally against your own API instead, put VITE_API_URL in
# web/.env.production.local (git ignores it).
VITE_API_URL=https://washnow-api.ttsbackend.htu.edu.gh
